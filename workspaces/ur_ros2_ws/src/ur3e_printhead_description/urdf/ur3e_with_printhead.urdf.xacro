<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur3e_printhead_preview">
  <!--
    Display-only UR3e model with the revised extruder rigidly attached to
    tool0.  No ros2_control or hardware interface is generated by this file.

    The mounting transform is geometry-derived but not yet installation-
    verified.  clocking selects one of the four candidates around the flange.
  -->
  <xacro:arg name="name" default="ur3e_printhead_preview"/>
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="clocking" default="0"/>
  <xacro:arg name="printhead_geometry"
             default="$(find ur3e_printhead_description)/config/printhead_geometry.json"/>
  <xacro:arg name="joint_limit_params"
             default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"
             default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"
             default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"
             default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <link name="world"/>
  <xacro:ur_robot
      name="$(arg name)"
      tf_prefix="$(arg tf_prefix)"
      parent="world"
      joint_limits_parameters_file="$(arg joint_limit_params)"
      kinematics_parameters_file="$(arg kinematics_params)"
      physical_parameters_file="$(arg physical_params)"
      visual_parameters_file="$(arg visual_params)"
      generate_ros2_control_tag="false"
      safety_limits="true"
      safety_pos_margin="0.15"
      safety_k_position="20">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- All head-specific defaults come from the workstation geometry profile.
       JSON is valid YAML and is supported by xacro.load_yaml. Clocking rotates
       the complete candidate transform around tool0, including translation. -->
  <xacro:property name="head" value="${xacro.load_yaml('$(arg printhead_geometry)')}"/>
  <xacro:property name="mount" value="${head['tool0_to_cad_origin_m']}"/>
  <xacro:property name="mount_rpy" value="${head['tool0_to_cad_rpy_deg']}"/>
  <xacro:property name="tip" value="${head['active_nozzle_in_cad_m']}"/>
  <xacro:property name="envelope" value="${head['collision_envelope_tool0_m']}"/>
  <xacro:property name="clocking_deg" value="${float('$(arg clocking)')}"/>
  <xacro:property name="clocking_rad" value="${(clocking_deg - head['clocking_deg']) * pi / 180.0}"/>
  <xacro:property name="mount_x" value="${mount['x'] * cos(clocking_rad) - mount['y'] * sin(clocking_rad)}"/>
  <xacro:property name="mount_y" value="${mount['x'] * sin(clocking_rad) + mount['y'] * cos(clocking_rad)}"/>

  <link name="$(arg tf_prefix)printhead_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${head['visual_mesh_uri']}"
              scale="1 1 1"/>
      </geometry>
      <material name="printhead_blue_grey">
        <color rgba="0.28 0.38 0.52 1"/>
      </material>
    </visual>

  </link>

  <joint name="$(arg tf_prefix)tool0-printhead_fixed_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg tf_prefix)printhead_link"/>
    <origin xyz="${mount_x} ${mount_y} ${mount['z']}"
            rpy="${mount_rpy['roll'] * pi / 180.0} ${mount_rpy['pitch'] * pi / 180.0} ${mount_rpy['yaw'] * pi / 180.0 + clocking_rad}"/>
  </joint>

  <!-- The shared envelope is already expressed in the installed tool0 frame.
       This sibling link keeps its dimensions independent of the CAD axes. -->
  <link name="$(arg tf_prefix)printhead_envelope">
    <collision>
      <origin xyz="${envelope['center']['x']} ${envelope['center']['y']} ${envelope['center']['z']}" rpy="0 0 0"/>
      <geometry>
        <box size="${envelope['size']['x']} ${envelope['size']['y']} ${envelope['size']['z']}"/>
      </geometry>
    </collision>
  </link>
  <joint name="$(arg tf_prefix)tool0-printhead_envelope_fixed_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg tf_prefix)printhead_envelope"/>
    <origin xyz="0 0 0" rpy="0 0 ${clocking_rad}"/>
  </joint>

  <!-- Right nozzle in the exported CAD pose: a candidate, not a measurement
       or proof of the selected mechanism end position. -->
  <link name="$(arg tf_prefix)nozzle_tcp">
    <visual>
      <geometry>
        <sphere radius="0.004"/>
      </geometry>
      <material name="candidate_tcp_orange">
        <color rgba="1.0 0.35 0.02 1"/>
      </material>
    </visual>
  </link>
  <joint name="$(arg tf_prefix)printhead-nozzle_tcp_fixed_joint" type="fixed">
    <parent link="$(arg tf_prefix)printhead_link"/>
    <child link="$(arg tf_prefix)nozzle_tcp"/>
    <origin xyz="${tip['x']} ${tip['y']} ${tip['z']}" rpy="0 0 0"/>
  </joint>

  <!-- Display the second exported tip without making it a planning TCP or
       asserting a selected/retracted state for the rack mechanism. -->
  <xacro:if value="${'standby_nozzle_in_cad_m' in head}">
    <xacro:property name="second_tip" value="${head['standby_nozzle_in_cad_m']}"/>
    <link name="$(arg tf_prefix)left_nozzle_candidate">
      <visual>
        <geometry><sphere radius="0.0033"/></geometry>
        <material name="exported_left_tip_grey"><color rgba="0.56 0.61 0.68 1"/></material>
      </visual>
    </link>
    <joint name="$(arg tf_prefix)printhead-left_nozzle_candidate_fixed_joint" type="fixed">
      <parent link="$(arg tf_prefix)printhead_link"/>
      <child link="$(arg tf_prefix)left_nozzle_candidate"/>
      <origin xyz="${second_tip['x']} ${second_tip['y']} ${second_tip['z']}" rpy="0 0 0"/>
    </joint>
  </xacro:if>
</robot>
